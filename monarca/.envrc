source_env_if_exists ".env"

if command -v volta >/dev/null 2>&1; then
  echo "Backend environment loaded with Volta"
elif [ -s "$HOME/.nvm/nvm.sh" ]; then
  source "$HOME/.nvm/nvm.sh"
  nvm use >/dev/null
  echo "Backend environment loaded with nvm"
fi

if [ ! -f .env ] && [ -f .env.example ]; then
  echo "Missing .env. Run: npm run setup:env"
fi